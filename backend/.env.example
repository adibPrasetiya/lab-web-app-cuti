NODE_ENV=development
PORT=3200

# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:password@localhost:3306/aplikasi_cuti

# Folder file lampiran upload, relatif terhadap folder kerja aplikasi.
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

LOG_DIR=logs
LOG_LEVEL=

# Pisahkan dengan koma untuk beberapa origin.
CORS_ORIGIN=*
