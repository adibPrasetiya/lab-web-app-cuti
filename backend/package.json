{
  "name": "aplikasi-cuti-backend",
  "version": "1.0.0",
  "description": "Backend aplikasi pengajuan cuti (lab bimtek audit keamanan)",
  "license": "ISC",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "test": "node --test test/**/*.test.js",
    "dev": "node --watch-path=src --watch-path=.env src/main.js serve",
    "start": "node src/main.js serve",
    "db:create": "node src/db/create.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/main.js migrate",
    "db:seed": "node src/main.js seed",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "2.8.6",
    "dotenv": "18.0.6",
    "drizzle-orm": "0.45.3",
    "express": "^5.2.1",
    "joi": "^18.2.9",
    "multer": "2.4.0",
    "mysql2": "3.24.5",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  },
  "engines": {
    "node": ">=20.6"
  }
}
